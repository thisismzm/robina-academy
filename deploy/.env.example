# Copy to .env (gitignored) and fill in. Everything here is loaded into the app
# container; URLs, cookies and connection strings are derived in
# docker-compose.yml from LEARNHOUSE_DOMAIN.

# ── Domain & TLS ──────────────────────────────────────────────────────────────
# Bare hostname, no scheme or port. DNS must already point at this server.
LEARNHOUSE_DOMAIN=academy.example.com
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=admin@example.com
# Optional: every hostname Caddy should get a certificate for, comma-separated.
# Defaults to LEARNHOUSE_DOMAIN.
# SITE_ADDRESSES=academy.example.com, www.academy.example.com

# Lock CORS/CSRF to your own domain. The built-in default matches any URL.
LEARNHOUSE_ALLOWED_REGEXP='^https://academy\.example\.com$'

# Single tenancy (one org) uses host-only cookies; LEARNHOUSE_COOKIE_DOMAIN is
# ignored. Multi tenancy (org.<domain> subdomains) needs EE or SaaS mode, a
# dotted LEARNHOUSE_COOKIE_DOMAIN, and every subdomain listed in SITE_ADDRESSES.
LEARNHOUSE_TENANCY=single
# LEARNHOUSE_COOKIE_DOMAIN=.academy.example.com

# ── Secrets ───────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
# Use hex for POSTGRES_PASSWORD: it goes into a URL unescaped.
POSTGRES_PASSWORD=
LEARNHOUSE_AUTH_JWT_SECRET_KEY=
NEXTAUTH_SECRET=
COLLAB_INTERNAL_KEY=

# ── First-boot install (only used while the database has no organization) ──
LEARNHOUSE_INITIAL_ADMIN_EMAIL=admin@example.com
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=
LEARNHOUSE_INITIAL_ORG_NAME=Robina Academy
LEARNHOUSE_INITIAL_ORG_SLUG=default

# ── Build ─────────────────────────────────────────────────────────────────────
# true strips the ee/ tree from the image (community build).
LEARNHOUSE_PUBLIC=true
APP_IMAGE=robina-academy
APP_TAG=latest

# ── Backups ───────────────────────────────────────────────────────────────────
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# ── Content delivery ──────────────────────────────────────────────────────────
LEARNHOUSE_CONTENT_DELIVERY_TYPE=filesystem
# LEARNHOUSE_CONTENT_DELIVERY_TYPE=s3api
# LEARNHOUSE_S3_API_BUCKET_NAME=
# LEARNHOUSE_S3_API_ENDPOINT_URL=

# ── Email (optional) ──────────────────────────────────────────────────────────
# LEARNHOUSE_EMAIL_PROVIDER=smtp
# LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=noreply@academy.example.com
# LEARNHOUSE_SMTP_HOST=
# LEARNHOUSE_SMTP_PORT=587
# LEARNHOUSE_SMTP_USERNAME=
# LEARNHOUSE_SMTP_PASSWORD=
# LEARNHOUSE_SMTP_USE_TLS=True
# LEARNHOUSE_RESEND_API_KEY=

# ── AI (optional) ─────────────────────────────────────────────────────────────
LEARNHOUSE_IS_AI_ENABLED=False
# LEARNHOUSE_GEMINI_API_KEY=

# ── Payments / integrations used by this fork (optional) ─────────────────────
# LEARNHOUSE_ZARINPAL_MERCHANT_ID=
# LEARNHOUSE_ZARINPAL_SANDBOX=False
# LEARNHOUSE_IRANKISH_TERMINAL_ID=
# LEARNHOUSE_IRANKISH_ACCEPTOR_ID=
# LEARNHOUSE_IRANKISH_PASS_PHRASE=
# LEARNHOUSE_IRANKISH_PUBLIC_KEY=
# LEARNHOUSE_SKYROOM_API_URL=
# LEARNHOUSE_SKYROOM_API_KEY=

# ── Monitoring (optional) ─────────────────────────────────────────────────────
# LEARNHOUSE_SENTRY_DSN=
